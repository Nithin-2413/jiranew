# MongoDB Connection
MONGO_URL="mongodb://localhost:27017"
DB_NAME="jira_reports"

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# Note: Jira credentials are NOT stored in the backend .env file
# Users enter their Jira credentials in the frontend UI, which are then
# passed securely through the API on each request. This allows multi-tenant
# usage without storing credentials server-side.
